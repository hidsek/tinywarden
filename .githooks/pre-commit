#!/usr/bin/env bash
# Runs before every commit (enable with tools/install-hooks.sh).
# 1. Nothing private in what is being committed (tools/check-leaks.sh --staged).
# 2. The author is the published one, not a real name: set user.name / user.email for this repository.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
tools/check-leaks.sh --staged >/dev/null || { tools/check-leaks.sh --staged; exit 1; }
ident="$(git var GIT_AUTHOR_IDENT)"
want_name="${TW_AUTHOR_NAME:-hidsek}"
case "$ident" in
  "$want_name <"*"@users.noreply.github.com>"*) ;;
  *) echo "pre-commit: author is '${ident% *}', expected '$want_name <...@users.noreply.github.com>'"
     echo "  git config user.name $want_name; git config user.email <id>+$want_name@users.noreply.github.com"
     echo "  (contributors: set TW_AUTHOR_NAME to your GitHub name, or skip this hook)"
     exit 1 ;;
esac
